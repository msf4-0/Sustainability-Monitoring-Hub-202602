# App
ENVIRONMENT=development
SECRET_KEY=change-me

APP_NAME=GHG Emissions Calculator
APP_VERSION=1.0.0

# Database
# When using the bundled Docker database (`docker compose up -d`), DB_PASSWORD
# is also read by docker-compose.yml as MARIADB_ROOT_PASSWORD, so keep them in
# sync. DB_USER must be "root" for the bundled container.
DB_HOST=127.0.0.1
DB_NAME=ghg_emissions_calculator_db
DB_USER=root
DB_PASSWORD=admin123
DB_PORT=3306
DB_SSL_DISABLED=true
